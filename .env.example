DATABASE_URL=postgresql+asyncpg://memory:memory@localhost:5432/memory
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=memory
S3_SECRET_ACCESS_KEY=memory-secret
S3_BUCKET=memory-dev
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=1536
MEMORY_CHUNK_TARGET_TOKENS=500
MEMORY_CHUNK_OVERLAP_TOKENS=80
MEMORY_LOCAL_MAX_UPLOAD_BYTES=33554432
MEMORY_ENABLE_DEVELOPMENT_MOCKS=false
MEMORY_AUTH_TOKEN_SECRET=development-only-replace-with-random-auth-secret
MEMORY_AUTH_TOKEN_TTL_SECONDS=604800

# Generate a production value with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OAUTH_CREDENTIAL_ENCRYPTION_KEY=development-only-replace-with-kms-managed-key

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://127.0.0.1:8000/sources/google-drive/oauth/callback
GOOGLE_OAUTH_FRONTEND_RETURN_URL=http://127.0.0.1:5173
